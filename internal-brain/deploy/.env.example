# Generate the real file with: python deploy/make_env.py   (never commit deploy/.env)
IB_DEMO_MODE=1
IB_SECRET_KEY=
IB_WEBHOOK_SECRET=
# Per-platform webhook secrets: Jira/Confluence webhook "secret" (X-Hub-Signature HMAC), Drive watch channel token.
IB_WEBHOOK_SECRET_CONFLUENCE=
IB_WEBHOOK_SECRET_JIRA=
IB_WEBHOOK_SECRET_GDRIVE=
IB_AUDIT_PSEUDONYM_KEY=
# 32 random bytes, base64. Held by the app runtime only; operators of the DB files never need it.
IB_AUDIT_CONTENT_KEY=
MINIO_ROOT_USER=storage-admin
MINIO_ROOT_PASSWORD=
CHECKPOINT_BUCKET=audit-checkpoints
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_WRITER_KEY=brain-checkpoint-writer
CHECKPOINT_WRITER_SECRET=
CHECKPOINT_READER_KEY=audit-verifier
CHECKPOINT_READER_SECRET=
# Optional model (Member 2): IB_LLM_PROVIDER=openai_compatible IB_LLM_BASE_URL= IB_LLM_MODEL= IB_LLM_API_KEY=
