# Documentation only: export these variables before starting; no automatic dotenv loader.
IB_DEMO_MODE=1
IB_LLM_PROVIDER=stub
IB_POLL_INTERVAL_S=300
IB_CONTEXT_BUDGET=7000
IB_CHECK_TIMEOUT_S=3
# Optional runtime folder (default ./data)
# IB_DATA_DIR=/absolute/path/to/runtime-data
# Model selection, optional. Set the real values in your secret manager/environment.
# IB_LLM_PROVIDER=openai_compatible
# IB_LLM_BASE_URL=https://your-provider.example/v1
# IB_LLM_MODEL=your-model-id
# IB_LLM_API_KEY=your-secret
# IB_LLM_TIMEOUT_S=20
# Optional live Slack. Also replace demo identity mapping before exposing real data.
# IB_DEMO_MODE=0
# IB_SLACK_CONFIG=/absolute/path/to/slack-config.json
# IB_SLACK_INGESTION_TOKEN=your-secret
# IB_SLACK_JANE_TOKEN=your-delegated-user-secret
# IB_SLACK_SIGNING_SECRET=your-secret
# Replace development keys for a deployment. SSO remains a separate integration.
# IB_SECRET_KEY=your-generated-secret
# IB_WEBHOOK_SECRET=your-generated-secret
# IB_AUDIT_PSEUDONYM_KEY=another-generated-secret
