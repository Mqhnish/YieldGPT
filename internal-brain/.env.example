# Automatically loaded from the project root; exported process variables win.
# Copy to .env for local settings. Values are literal, not shell commands.
IB_DEMO_MODE=1
IB_LLM_PROVIDER=stub
IB_LLM_REQUIRE_LIVE=0
IB_POLL_INTERVAL_S=300
IB_CONTEXT_BUDGET=7000
IB_CHECK_TIMEOUT_S=3
# Approved model: replace placeholders, then set provider=openai_compatible and require_live=1.
IB_LLM_BASE_URL=YOUR_APPROVED_PROVIDER_BASE_URL
IB_LLM_MODEL=YOUR_APPROVED_MODEL_ID
IB_LLM_API_KEY=YOUR_APPROVED_MODEL_KEY
IB_LLM_TIMEOUT_S=20
# Optional actual per-million-token prices. Unknown price remains null in reports.
IB_LLM_INPUT_PER_MILLION=
IB_LLM_OUTPUT_PER_MILLION=
IB_LLM_CURRENCY=USD
# Leave blank to keep the fictional Slack connector.
IB_SLACK_CONFIG=
TEAM_ONE_INGESTION_TOKEN=YOUR_TEAM_ONE_INGESTION_TOKEN
TEAM_ONE_SIGNING_SECRET=YOUR_TEAM_ONE_SIGNING_SECRET
TEAM_ONE_JANE_TOKEN=YOUR_TEAM_ONE_DELEGATED_TOKEN
TEAM_TWO_INGESTION_TOKEN=YOUR_TEAM_TWO_INGESTION_TOKEN
TEAM_TWO_SIGNING_SECRET=YOUR_TEAM_TWO_SIGNING_SECRET
TEAM_TWO_JANE_TOKEN=YOUR_TEAM_TWO_DELEGATED_TOKEN
# Optional delegated OAuth installation store. Enable only with real application settings.
IB_SLACK_TOKEN_KEY=
IB_SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
IB_SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
IB_SLACK_REDIRECT_URI=http://127.0.0.1:8000/api/slack/oauth/callback
# For deployment secrets, encryption, and independent WORM checkpoints:
# use deploy/make_env.py and docs/MEMBER3.md. Seeded demo login is not SSO.

# Atlassian (Confluence + Jira): fixture (offline, default) | live | sim
IB_ATLASSIAN_MODE=fixture
IB_ATLASSIAN_SITE=
IB_ATLASSIAN_EMAIL=
IB_ATLASSIAN_API_TOKEN=
IB_ACCOUNT_MAP=
IB_RECONCILE_EVERY_S=600
